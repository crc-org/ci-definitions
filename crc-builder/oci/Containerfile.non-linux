FROM registry.access.redhat.com/ubi8/ubi-minimal as preparer

ARG OS
ARG RCLONE_VERSION=1.75.2
ENV OS ${OS}

RUN microdnf -y install unzip && \
    cd /tmp && \
    if [ "${OS}" = "windows" ]; then \
        archive="rclone-v${RCLONE_VERSION}-windows-amd64.zip"; \
        platform=windows-amd64; \
        checksum="8a9db2bad1dc79a65b3348fd857069598e2aab7cf4d118b77b1df23055aff818"; \
        binary=rclone.exe; \
    else \
        archive="rclone-v${RCLONE_VERSION}-osx-amd64.zip"; \
        platform=osx-amd64; \
        checksum="574e1f31cf1c464e5fb0325cb66fcbdeaf1efa1802bd9b17f13c256fd74b6561"; \
        binary=rclone; \
    fi && \
    curl -fsSL "https://downloads.rclone.org/v${RCLONE_VERSION}/${archive}" -o "${archive}" && \
    printf '%s  %s\n' "${checksum}" "${archive}" | sha256sum -c - && \
    unzip -q "${archive}" && \
    cp "rclone-v${RCLONE_VERSION}-${platform}/${binary}" "/tmp/${binary}" && \
    if [ "${binary}" = "rclone" ]; then chmod +x /tmp/rclone; fi && \
    rm -rf "${archive}" "rclone-v${RCLONE_VERSION}-${platform}" && \
    microdnf clean all
    
#v0.0.6
FROM quay.io/devtools-qe-incubator/deliverest:v0.0.7

LABEL org.opencontainers.image.authors="CRCQE <devtools-crc-qe@redhat.com>"

ARG OS 

ENV ASSETS_FOLDER=/opt/crc-builder \
    OS=${OS}

COPY --from=preparer /tmp/* ${ASSETS_FOLDER}/
COPY lib/${OS}/* ${ASSETS_FOLDER}/